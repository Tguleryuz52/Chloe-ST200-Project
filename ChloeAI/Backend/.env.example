# Copy this file to .env and fill in values.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-20250514
WHISPER_MODEL=whisper-1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

WHISPER_LANGUAGE=tr

WS_HOST=127.0.0.1
WS_PORT=8765

# Microphone (silence-based end of utterance)
SAMPLE_RATE=16000
SILENCE_DURATION_MS=800
MIN_SPEECH_MS=400
MIN_AUDIO_RMS=0.015

LOG_LEVEL=INFO

# Optional: override WAV output folder (default: ../Audio under ChloeAI root)
# AUDIO_OUTPUT_DIR=C:\Users\You\Desktop\Chloe_ST200\ChloeAI\Audio
